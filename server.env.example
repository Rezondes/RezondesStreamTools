# Kopieren nach server.env und ausfüllen. server.env wird nie eingecheckt.
# App anlegen: https://dev.twitch.tv/console/apps
#   OAuth Redirect URL: PUBLIC_URL/auth/callback, lokal http://localhost:8089/auth/callback  (Port wie in docker-compose.yml)
#   Kategorie: Broadcaster Suite, Client-Typ: Vertraulich
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Admins: Twitch-Logins mit Komma, dürfen sich immer anmelden und Zugang und Funktionsstufen ändern
ADMINS=

# Adresse, unter der Browser und OBS den Server erreichen (ohne / am Ende). Im Docker-Container setzt
# docker-compose.yml http://localhost:8089; für einen öffentlichen Server die HTTPS-Adresse eintragen.
# PUBLIC_URL=https://overlays.example.org

# Optional: Spotify "Now Playing" (Overlay music.html), jeder Streamer verbindet sein eigenes Konto
# App anlegen: https://developer.spotify.com/dashboard
#   Redirect URI: lokal http://127.0.0.1:8089/spotify/callback (Spotify erlaubt kein "localhost"), öffentlich PUBLIC_URL/spotify/callback
#   API: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Speicher für alle Medien eines Streamers zusammen in MB (Standard 200)
# MEDIA_LIMIT_MB=200

# Nur im öffentlichen Betrieb (docker-compose.public.yml): Domain des Servers, z.B. overlays.example.de.
# Caddy holt dafür das Zertifikat; PUBLIC_URL wird https://<DOMAIN>.
# DOMAIN=
