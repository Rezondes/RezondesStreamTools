# Copy to server.env and fill in. server.env is never committed.
# Create an app: https://dev.twitch.tv/console/apps
#   OAuth Redirect URL: PUBLIC_URL/auth/callback, locally http://localhost:8089/auth/callback  (port as in docker-compose.yml)
#   Category: Broadcaster Suite, Client Type: Confidential
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Admins: Twitch logins separated by commas, may always log in and change access and feature levels
ADMINS=

# URL under which browser and OBS reach the server (without a trailing /). In the Docker container
# docker-compose.yml sets http://localhost:8089; for a public server enter the HTTPS URL.
# PUBLIC_URL=https://overlays.example.org

# Optional: Spotify "Now Playing" (overlay music.html), every streamer connects their own account
# Create an app: https://developer.spotify.com/dashboard
#   Redirect URI: locally http://127.0.0.1:8089/spotify/callback (Spotify does not allow "localhost"), publicly PUBLIC_URL/spotify/callback
#   API: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: storage for all media of a streamer together in MB (default 200)
# MEDIA_LIMIT_MB=200

# Only in public operation (docker-compose.public.yml): domain of the server, e.g. overlays.example.org.
# Caddy fetches the certificate for it; PUBLIC_URL becomes https://<DOMAIN>.
# DOMAIN=

# Tests only (contract tests, contract/): replace Twitch and Spotify with the fake provider.
# Without these variables the real URLs apply. Never set them in production.
# TWITCH_ID_URL=http://127.0.0.1:9900/oauth2
# TWITCH_API_URL=http://127.0.0.1:9900/helix
# TWITCH_EVENTSUB_URL=ws://127.0.0.1:9900/eventsub
# TWITCH_IRC_URL=ws://127.0.0.1:9900/irc
# SPOTIFY_ACCOUNTS_URL=http://127.0.0.1:9900/spotify-accounts
# SPOTIFY_API_URL=http://127.0.0.1:9900/spotify-api
