# Kopieren nach server.env und ausfüllen. server.env wird nie eingecheckt.
# App anlegen: https://dev.twitch.tv/console/apps
#   OAuth Redirect URL: http://localhost:8089/auth/callback  (Port wie in docker-compose.yml)
#   Kategorie: Broadcaster Suite, Client-Typ: Vertraulich
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Spotify "Now Playing" (Overlay music.html)
# App anlegen: https://developer.spotify.com/dashboard
#   Redirect URI: http://127.0.0.1:8089/spotify/callback  (Port wie in docker-compose.yml, Spotify erlaubt kein "localhost")
#   API: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
