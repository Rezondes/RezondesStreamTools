{
  "triggers": [
    {
      "name": "lizard-test",
      "when": {
        "type": "word",
        "match": "LIZARD-TEST"
      },
      "who": [
        "broadcaster"
      ],
      "cooldown": 1,
      "userCooldown": 1,
      "do": [
        {
          "type": "media",
          "zone": "main",
          "image": "lizard.svg",
          "sound": "lizard.wav",
          "volume": 0.8,
          "duration": 4,
          "position": "random",
          "size": 360
        }
      ],
      "enabled": false
    },
    {
      "name": "lizard",
      "when": {
        "type": "word",
        "match": "LIZARD"
      },
      "who": [
        "everyone"
      ],
      "cooldown": 0,
      "userCooldown": 0,
      "do": [
        {
          "type": "media",
          "zone": "main",
          "video": "lizard.mp4",
          "volume": 1,
          "delay": 0.5,
          "duration": 1,
          "after": 0.2,
          "position": "random",
          "size": 250
        }
      ]
    },
    {
      "name": "hallo",
      "enabled": false,
      "when": {
        "type": "command",
        "match": "!hallo"
      },
      "who": [
        "everyone"
      ],
      "cooldown": 10,
      "do": [
        {
          "type": "text",
          "zone": "main",
          "text": "HALLO {user}",
          "duration": 3,
          "position": {
            "x": 50,
            "y": 20
          }
        }
      ]
    }
  ]
}
