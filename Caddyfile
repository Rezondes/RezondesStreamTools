# Caddy in front of the overlay server in public operation (docker-compose.public.yml): fetches the certificate for DOMAIN
# automatically (Let's Encrypt), redirects HTTP to HTTPS and passes everything on to the overlay server.
{$DOMAIN} {
	reverse_proxy overlays:8080 {
		# Pass on server-sent events (/s/<login>/events) immediately, do not buffer
		flush_interval -1
	}
}
