{
  "name": "rezondesstream",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node --env-file=server.env scripts/rust.ts serve",
    "demo": "node scripts/rust.ts build && node scripts/demo.ts",
    "check": "npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=95 --test-coverage-exclude=\"**/*.check.ts\" --test-coverage-exclude=\"scripts/**\" --test-coverage-exclude=\"contract/**\" \"src/**/*.check.ts\" \"scripts/**/*.check.ts\" \"contract/**/*.check.ts\"",
    "rust": "node scripts/rust.ts",
    "gen:types": "node scripts/rust.ts gen:types",
    "contract": "node scripts/rust.ts build && node contract/run.ts",
    "verify": "npm run typecheck && npm run lint && npm test && vite build && node scripts/bundle.ts && npm run rust",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.1",
    "figlet": "1.12.0",
    "gsap": "3.15.0",
    "pixi.js": "8.22.0",
    "postprocessing": "6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "4.6.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
